# ---- 外部既有基础设施（本仓库不编排，全部由既有环境提供） ----
# PostgreSQL（平台主库）
POSTGRES_URL=jdbc:postgresql://<你的PG地址>:5432/zhijin
POSTGRES_USER=zhijin
POSTGRES_PASSWORD=***

# Redis（会话/缓存/限流/异步流）
REDIS_ADDR=127.0.0.1:6379

# Nacos（注册/配置中心）
NACOS_ADDR=127.0.0.1:8848

# Elasticsearch（向量+全文检索）
ES_ADDR=http://127.0.0.1:9200

# MinIO（对象存储，S3 兼容接口）
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=zhijin
MINIO_SECRET_KEY=***
