<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.zhijin</groupId>
    <artifactId>zhijin-server</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>zhijin-app</artifactId>

  <dependencies>
    <dependency><groupId>com.zhijin</groupId><artifactId>zhijin-common</artifactId></dependency>
    <dependency><groupId>com.zhijin</groupId><artifactId>zhijin-framework</artifactId></dependency>
    <dependency><groupId>com.zhijin</groupId><artifactId>zhijin-auth</artifactId></dependency>
    <dependency><groupId>com.zhijin</groupId><artifactId>zhijin-orchestrator</artifactId></dependency>
    <dependency><groupId>com.zhijin</groupId><artifactId>zhijin-chat</artifactId></dependency>
    <dependency><groupId>com.zhijin</groupId><artifactId>zhijin-tool</artifactId></dependency>
    <dependency><groupId>com.zhijin</groupId><artifactId>zhijin-billing-audit</artifactId></dependency>
    <dependency><groupId>com.zhijin</groupId><artifactId>zhijin-ai-client</artifactId></dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <version>${spring-boot.version}</version>
        <executions>
          <execution>
            <goals><goal>repackage</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
