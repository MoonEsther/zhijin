# ---- 外部既有基础设施（本仓库不编排，全部由既有环境提供） ----
# PostgreSQL（平台主库）
POSTGRES_URL=jdbc:postgresql://<你的PG地址>:5432/postgres
POSTGRES_USER=<PG账号>
POSTGRES_PASSWORD=***

# Redis（会话/缓存/限流/异步流，密码认证）
REDIS_ADDR=<Redis地址>:30379
REDIS_PASSWORD=***

# Nacos（注册/配置中心，含认证）
NACOS_ADDR=<Nacos地址>:8848
NACOS_USERNAME=<Nacos账号>
NACOS_PASSWORD=***

# Elasticsearch（向量+全文检索，HTTP + 认证）
ES_ADDR=http://<ES地址>:30200
ES_USERNAME=<ES账号>
ES_PASSWORD=***

# MinIO（对象存储，S3 兼容接口）
MINIO_ENDPOINT=http://<MinIO地址>:30900
MINIO_ACCESS_KEY=<MinIO账号>
MINIO_SECRET_KEY=***

# ---- 模型供应商（AI 服务 /v1/chat/completions；LangChain 统一 base_url+api_key 抽象） ----
# 一次配一个默认供应商；请求可携带 provider/api_key 覆盖。BASE_URL 留空走官方默认地址，可改代理/网关
PROVIDER=qwen          # qwen / openai / deepseek / claude
BASE_URL=
API_KEY=
